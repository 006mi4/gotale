{
    "version": "2.0.0",
    "git_repo_url": "https://github.com/006mi4/gotale.git",
    "web_interface": {
        "host": "0.0.0.0",
        "port": 5000
    },
    "java": {
        "required_version": 25,
        "download_url": "https://www.oracle.com/java/technologies/downloads/"
    },
    "hytale": {
        "downloader_url": "https://downloader.hytale.com/hytale-downloader.zip",
